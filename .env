# API проекта
ALLOWED_ORIGINS=*
AUTH_TOKENS=
ADMIN_TOKEN=

# Провайдер: extractive, openai, ollama или gigachat
AI_PROVIDER=gigachat
AI_CONFIG_PATH=config/ai.json
AI_API_TIMEOUT=15

# GigaChat
# Ключ авторизации из кабинета GigaChat API. Не коммитьте настоящий ключ.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1

# Для OpenAI-compatible API / Ollama, если они используются вместо GigaChat
LLM_URL=
LLM_MODEL=
AI_API_KEY=

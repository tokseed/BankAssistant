# Домен на IP вашего VPS. Без домена: DOMAIN=:80 (HTTP по IP).
# HTTPS без покупки домена: IP через дефисы + .sslip.io, например 203-0-113-10.sslip.io
DOMAIN=:80

# Адреса порталов, где стоит виджет (вместо * в проде): https://portal.corp.local
ALLOWED_ORIGINS=*

# Роли. Пусто = открытый демо-режим (все как employee).
# Формат: токен:роль,токен:роль   (роли: employee, manager, expert)
AUTH_TOKENS=

# Токен для POST /api/admin/kb/reload
ADMIN_TOKEN=

# Локальная LLM (необязательно). Без неё ответ даётся дословной выдержкой из пунктов.
# docker compose --profile llm up -d && docker compose exec ollama ollama pull qwen2.5:7b-instruct
LLM_URL=
LLM_MODEL=

# Optional vector retrieval through local Ollama embeddings. First run builds FAISS locally.
RAG_ENABLED=false
EMBEDDING_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=4
# Maximum FAISS L2 distance; tune against the selected embedding model.
RAG_MAX_DISTANCE=1.5

# Optional SQL Server execution logging (ODBC connection string).
SQLSERVER_CONNECTION_STRING=
